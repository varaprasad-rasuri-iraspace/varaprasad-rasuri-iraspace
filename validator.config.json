{
  "jiraBaseUrl": "https://tempofficial02.atlassian.net",
  "jiraProjectKey": "KAN",
  "jiraDefaultIssueKey": "KAN-1",
  "scmDefaultFeatureBranch": "origin/kan-1-leetcode-link-fix",
  "scmDefaultPreviewPayload": true,
  "scmDefaultSummary": true,
  "scmDefaultAiStageAPreview": true,
  "jiraDefaultComments": true,
  "scmDefaultBaseBranch": "origin/dev",
  "scmDefaultRemote": "origin",
  "scmAllowedRemotes": ["https://github.com/varaprasad-rasuri-iraspace/*"],
  "jiraValidationDefaults": {
    "readDescription": true,
    "readComments": true,
    "runJiraQualityCheck": true
  },
  "scmValidationDefaults": {
    "branchBehindWarningThreshold": 25
  },
  "aiProvider": "openai",
  "aiModel": "gpt-4o",
  "scmDiff": {
    "contextLines": 1,
    "mode": "direct"
  },
  "stackContext": "Next.js App Router + NestJS",
  "excludePaths": [
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "dist/*",
    ".next/*",
    "build/*",
    "node_modules/*",
    "*.snap",
    "*.min.js",
    "*.bundle.js"
  ],
  "testFilePatterns": ["*.test.ts", "*.spec.ts", "__tests__/**", "e2e/**"],
  "budgetLimits": {
    "aiMaxDiffChars": 24000,
    "maxDiffCharsHardLimit": 80000,
    "maxAiCallsPerRun": 12,
    "requireConfirmationAboveChars": 50000,
    "aiChunkMaxChars": 12000,
    "aiChunkMaxCount": 12
  },
  "policy": {
    "allowExternalAiCalls": true,
    "allowPostingToJira": false
  }
}
